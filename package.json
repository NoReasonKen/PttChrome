{
  "name": "pttchrome",
  "version": "1.2.0",
  "description": "PTT BBS 網頁版終端機增強版（基於 term.ptt.cc 的 robertabcd/PttChrome）",
  "homepage": "https://noreasonken.github.io/PttChrome/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoReasonKen/PttChrome.git"
  },
  "bugs": "https://github.com/NoReasonKen/PttChrome/issues",
  "license": "GPL-2.0-only",
  "private": true,
  "packageManager": "yarn@4.17.0",
  "dependencies": {
    "@mantine/core": "^9",
    "@mantine/hooks": "^9",
    "@tabler/icons-react": "^3.49.0",
    "classnames": "^2.5.1",
    "firebase": "^13.0.0",
    "photoswipe": "^5.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "husky": "^9.0.0",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.30",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.json": "prettier --write",
    "src/components/**/*.{js,jsx,json,css}": "prettier --write",
    "src/render/**/*.js": "prettier --write"
  },
  "scripts": {
    "setup": "yarn install --immutable && yarn prepare && node scripts/check-git-hooks.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check:credentials": "node scripts/scan-credentials.mjs --tracked",
    "prepare": "husky",
    "build": "vite build",
    "start": "vite",
    "test:unit": "vitest run --project unit --project unit-browser",
    "test:integration": "node scripts/run-integration.mjs",
    "kill:dev": "node scripts/kill-dev-server.js",
    "ci:status": "node scripts/ci-status.mjs",
    "ci:ack": "node scripts/ci-watch-state.mjs",
    "verify:commit": "node scripts/verify-commit.mjs",
    "debug:screens": "node scripts/debug-screens.mjs",
    "test:e2e": "yarn kill:dev && playwright test --project=live",
    "test:e2e:offline": "yarn kill:dev && playwright test --project=offline --project=offline-firefox --project=offline-mobile",
    "test:e2e:offline:firefox": "yarn kill:dev && playwright test --project=offline-firefox",
    "test:e2e:offline:adverse": "yarn kill:dev && node scripts/run-adverse-e2e.mjs",
    "test:e2e:android": "yarn kill:dev && node scripts/run-android-e2e.mjs",
    "test:e2e:headed": "yarn kill:dev && playwright test --project=live --headed",
    "test:e2e:ui": "yarn kill:dev && playwright test --ui",
    "record:cassette": "yarn kill:dev && RECORD_CASSETTE=1 playwright test --project=record tools/record-cassette",
    "measure:layers": "yarn kill:dev && MEASURE_LAYERS=1 playwright test --project=offline-measure",
    "record:scenarios": "yarn kill:dev && RECORD_SCENARIOS=1 playwright test --project=record tools/record-scenarios",
    "triage:recordings": "yarn kill:dev && playwright test --project=offline-triage"
  }
}
